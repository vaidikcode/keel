# Copy to .env.local by running `bunx convex dev` against project `keel`.
# Each developer gets their own file. Never commit it. Never put the
# production CONVEX_DEPLOY_KEY here — that lives only as a GitHub Actions secret.

# Local backend (typical):
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# CONVEX_DEPLOYMENT=local:<your-local-deployment-name>

# Production client URL (Vercel / hosted Next.js only, not local):
# NEXT_PUBLIC_CONVEX_URL=https://youthful-manatee-537.convex.cloud

# Copy to .env.local by running `bunx convex dev` against project `keel`.
# Each developer gets their own file. Never commit it. Never put the
# production CONVEX_DEPLOY_KEY here — that lives only as a GitHub Actions secret.

# Local backend (typical):
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# CONVEX_DEPLOYMENT=local:<your-local-deployment-name>

# Production client URL (Vercel / hosted Next.js only, not local):
# NEXT_PUBLIC_CONVEX_URL=https://youthful-manatee-537.convex.cloud

# Finnhub — optional, adds dated company news to News and facts.
# Free signup: https://finnhub.io/register — 60 calls/min. Server-only.
FINNHUB_API_KEY=

# SEC EDGAR User-Agent — required string, not a secret. Format: Keel you@email.com
# SEC 403s without this. No signup.
SEC_USER_AGENT=Keel you@email.com

# Tavily web search — optional, server-only. Powers "recent facts" on each
# category and asset page.
# Free signup: https://tavily.com — Missing → rankings still work, facts sections
# are empty and the response carries a "tavily:off" warning.
TAVILY_API_KEY=

# CoinGecko Demo key — optional. Keyless public API works; demo key is safer on Vercel.
# Free: https://www.coingecko.com/en/api — header x-cg-demo-api-key. Server-only.
# COINGECKO_API_KEY=

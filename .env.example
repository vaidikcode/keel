# Copy to .env.local by running `bunx convex dev` against project `keel`.
# Each developer gets their own file. Never commit it. Never put the
# production CONVEX_DEPLOY_KEY here — that lives only as a GitHub Actions secret.

# Local backend (typical):
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# CONVEX_DEPLOYMENT=local:<your-local-deployment-name>

# Production client URL (Vercel / hosted Next.js only, not local):
# NEXT_PUBLIC_CONVEX_URL=https://youthful-manatee-537.convex.cloud

# Vercel AI Gateway — server-only. Create at vercel.com/d?to=%2F~%2Fai%2Fapi-keys
# Local: paste into .env.local. Vercel: Project → Settings → Environment Variables
# (Production + Preview). Never prefix with NEXT_PUBLIC_.
# Powers dashboard explanations and follow-up questions. No per-conversation call cap.
# Missing → charts and local explanations still work; new questions show an unavailable state.
AI_GATEWAY_API_KEY=

# Finnhub — optional, adds dated company news to News and facts.
# Free signup: https://finnhub.io/register — 60 calls/min. Server-only.
FINNHUB_API_KEY=

# SEC EDGAR User-Agent — required string, not a secret. Format: Keel you@email.com
# SEC 403s without this. No signup.
SEC_USER_AGENT=Keel you@email.com

# Tavily web search — optional, server-only. Powers "recent facts" on each
# category and asset page and the assistant's searchWeb tool.
# Free signup: https://tavily.com — Missing → rankings still work, facts sections
# are empty and the response carries a "tavily:off" warning.
TAVILY_API_KEY=

# Assistant model behind the Vercel AI Gateway. Optional; defaults to openai/gpt-4o-mini.
# KEEL_MODEL=openai/gpt-4o-mini

# Convex-side (bunx convex env set KEEL_REQUIRE_AUTH true): when "true", profile
# and thoughts functions require a Clerk identity matching the sessionId.
# Leave unset until the Clerk JWT template "convex" exists on that instance.
# KEEL_REQUIRE_AUTH=

# CoinGecko Demo key — optional. Keyless public API works; demo key is safer on Vercel.
# Free: https://www.coingecko.com/en/api — header x-cg-demo-api-key. Server-only.
# COINGECKO_API_KEY=

# Clerk — login. Dashboard at https://dashboard.clerk.com → API keys.
# Local uses the Development instance (pk_test_ / sk_test_).
# Vercel Production uses the Production instance (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Convex Clerk issuer (Frontend API URL). Not a Next.js secret — set on Convex:
#   Local:  bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<dev>.clerk.accounts.dev
#   Prod:   Convex dashboard → keel production → env, or:
#           bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://clerk.keel.my --prod
# Copy the URL from Clerk → Configure → Convex (or API keys → Frontend API URL).
# CLERK_JWT_ISSUER_DOMAIN=
